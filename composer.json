{
    "name": "dply/queue-insights",
    "description": "dply Queue driver and queue job lifecycle reporting for Laravel.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Dply\\QueueInsights\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dply\\QueueInsights\\QueueInsightsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "keywords": [
        "laravel",
        "queue",
        "dply"
    ]
}
